# Copy this file to `.env` (or set these in your shell / Azure App Service)
# and fill in your own values. Never commit the filled-in .env.

# Azure Blob Storage account URL. Leave empty to run fully local (no cloud).
BLOB_ACCOUNT_URL=https://YOURACCOUNT.blob.core.windows.net

# Prefix for your container names, e.g. containers named "myprefix-results".
# Leave empty if your containers are just "uploads"/"assets"/"results".
BLOB_CONTAINER_PREFIX=

# Set to 1 to disable Blob entirely and keep everything in-session.
LOCAL_ONLY=0
